// The Install screen: only in `slingshot config` on the desktop. It shows
// what scripts/slingshot-setup says about this computer, and runs its
// commands (src/desktop/install.rs).

import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Button, Panel } from "widgets.slint";
import { InfoRow } from "system-screen.slint";

export struct InstallInfo {
    // The status has been read.
    known: bool,
    // Why it couldn't be read (efibootmgr missing, no ESP…).
    error: string,
    esp: string,
    installed: bool,
    file: string,
    // The Boot#### number, or "".
    entry: string,
    // In the boot order: "first", "later" or "none".
    order: string,
    systemd-boot: bool,
    systemd-boot-entry: bool,
    secure-boot: bool,
    // The slingshot.efi to install ("" if none was found).
    program: string,
}

// The Install screen (screen 3): only in `slingshot config`. Each step
// shows its commands first (a dry run), then runs once confirmed.
export global Install {
    in property <bool> available: Platform.uses-mock-data;
    in property <InstallInfo> info: Platform.uses-mock-data ? {
        known: true,
        esp: "/sample/esp",
        installed: true,
        file: "/sample/esp/EFI/slingshot/slingshot.efi",
        entry: "0001",
        order: "later",
        systemd-boot: true,
        program: "/sample/slingshot.efi",
    } : {};
    // A step is running.
    in property <bool> busy;
    // A step's commands, to confirm.
    in-out property <bool> confirm-visible;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <bool> confirm-destructive;
    // What a step did.
    in-out property <bool> result-visible;
    in property <bool> result-ok;
    in property <string> result-text;
    in property <bool> offer-restart;
    // The dry run of a step, in install.rs `Action::ALL` order: 0 install,
    // 1 try, 2 make default, 3 undefault, 4 systemd-boot entry, 5 uninstall.
    callback act(int);
    // Runs the step confirmed.
    callback confirm();
    callback choose-program();
    callback restart();
}

// A card of the right column: a title with its icon, then the contents.
component Card inherits Panel {
    in property <string> title;
    in property <string> icon;
    VerticalLayout {
        padding: 22px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 10px;
            Icon {
                kind: root.icon;
                size: 18px;
                thickness: 2px;
                color: Theme.accent;
            }
            Text {
                text: root.title;
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
        @children
    }
}

export component InstallScreen inherits Rectangle {
    out property <bool> ready: Install.info.known && Install.info.error == "" && !Install.busy;
    // What each focus item can do now.
    out property <bool> can-install: root.ready && Install.info.program != "";
    out property <bool> can-start: root.ready && Install.info.entry != "";
    out property <bool> has-sd-item: Install.info.systemd-boot && !Install.info.systemd-boot-entry;
    out property <bool> can-uninstall: root.ready && (Install.info.installed || Install.info.entry != "");

    // Entering the screen: the keyboard focus on its first button.
    public function enter() {
        choose.focus();
    }

    // Laid out like the System screen.
    HorizontalLayout {
        padding-top: 32px;
        padding-left: 64px;
        padding-right: 64px;
        padding-bottom: 20px;
        spacing: 28px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 18px;
            alignment: start;

            Panel {
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 20px;
                        Text {
                            text: @tr("This computer");
                            font-size: 22px;
                            font-weight: 600;
                            color: Theme.text;
                            height: 64px;
                            vertical-alignment: center;
                        }
                    }
                    if !Install.info.known: InfoRow { icon: "computer"; label: @tr("Reading…"); }
                    if Install.info.known && Install.info.error != "": InfoRow {
                        icon: "shield-off";
                        warn: true;
                        label: Install.info.error;
                    }
                    if Install.info.known && Install.info.error == "": VerticalLayout {
                        InfoRow {
                            icon: "disc";
                            label: @tr("EFI System Partition");
                            title: Install.info.esp;
                        }
                        InfoRow {
                            icon: "app";
                            label: @tr("Slingshot");
                            title: Install.info.installed ? @tr("Installed") : @tr("Not installed");
                            detail: Install.info.installed ? Install.info.file : "";
                            good: Install.info.installed;
                        }
                        InfoRow {
                            icon: "firmware";
                            label: @tr("Firmware entry");
                            title: Install.info.entry != "" ? @tr("Boot") + Install.info.entry : @tr("None");
                            good: Install.info.entry != "";
                        }
                        InfoRow {
                            icon: "play";
                            label: @tr("Starts");
                            title: Install.info.entry == "" ? @tr("Never")
                                : Install.info.order == "first" ? @tr("On every boot") : @tr("Only when chosen");
                            detail: Install.info.entry == "" ? ""
                                : Install.info.order == "first" ? @tr("First in the boot order") : @tr("Once, or from the firmware's boot menu");
                            good: Install.info.order == "first";
                        }
                        if Install.info.systemd-boot: InfoRow {
                            icon: "list";
                            label: "systemd-boot";
                            title: @tr("Found");
                            detail: Install.info.systemd-boot-entry ? @tr("Slingshot is in its menu too") : @tr("Its entries are cards in Slingshot");
                        }
                        InfoRow {
                            icon: Install.info.secure-boot ? "shield-on" : "shield-off";
                            label: @tr("Secure Boot");
                            title: Install.info.secure-boot ? @tr("On") : @tr("Off");
                            detail: Install.info.secure-boot ? @tr("The firmware only starts Slingshot once it is signed") : "";
                            warn: Install.info.secure-boot;
                        }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                Text {
                    text: @tr("Each step first shows what it will change, then asks for your password.");
                    font-size: 13px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }

        VerticalLayout {
            width: 420px;
            spacing: 18px;
            alignment: start;

            Card {
                title: Install.info.installed ? @tr("Update") : @tr("Install");
                icon: "disc";
                Text {
                    text: Install.info.program != "" ? Install.info.program : @tr("Slingshot's boot program (slingshot.efi) wasn't found: choose it.");
                    font-size: 14px;
                    color: Install.info.program != "" ? Theme.text : Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    choose := Button {
                        text: @tr("Choose…");
                        clicked => { Install.choose-program(); }
                    }
                    Button {
                        text: Install.info.installed ? @tr("Update") : @tr("Install");
                        primary: true;
                        enabled: root.can-install;
                        clicked => { Install.act(0); }
                    }
                }
                Text {
                    text: @tr("Copies it to the boot partition and adds it to the computer's boot menu. Nothing starts differently yet.");
                    font-size: 13px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            Card {
                title: @tr("Start Slingshot");
                icon: "play";
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button {
                        text: @tr("Once, on the next restart");
                        enabled: root.can-start;
                        clicked => { Install.act(1); }
                    }
                    Button {
                        text: Install.info.order == "first" ? @tr("Not on every boot") : @tr("On every boot");
                        enabled: root.can-start;
                        clicked => { Install.act(Install.info.order == "first" ? 3 : 2); }
                    }
                    if root.has-sd-item: Button {
                        text: @tr("Also in systemd-boot's menu");
                        enabled: root.ready && Install.info.installed;
                        clicked => { Install.act(4); }
                    }
                }
                Text {
                    text: @tr("Once: the restart after that goes back to normal, whatever happens. On every boot: Slingshot starts your previous default after its countdown.");
                    font-size: 13px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Uninstall…");
                    danger: true;
                    enabled: root.can-uninstall;
                    clicked => { Install.act(5); }
                }
            }
        }
    }
}
