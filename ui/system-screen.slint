import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { InfoItem, MemorySegment, Button, BatteryInfo, Panel, ScrollList } from "widgets.slint";
import { AboutSlint } from "std-widgets.slint";

// A temperature: its gauge (`level`, 0 to 1), whether it's near its
// critical temperature, its graph (SVG paths in 100 × 30: the line, the area
// under it).
export struct SensorLine {
    name: string,
    value: string,
    level: float,
    hot: bool,
    line: string,
    area: string,
}

export struct FanLine {
    name: string,
    rpm: int,
}

// The System screen's data, and its clock.
export global System {
    in property <[InfoItem]> items: Platform.uses-mock-data ? [
        { label: "Processor", icon: "cpu", title: "Sample processor", detail: "Sample data" },
        { label: "Memory", icon: "memory", title: "Sample memory", detail: "Sample data" },
        { label: "System", icon: "computer", title: "Sample computer", detail: "Sample data" },
        { label: "Firmware", icon: "firmware", title: "Sample firmware", detail: "Sample data" },
        { label: "Secure Boot", title: "Sample state", detail: "Sample data", icon: "shield-off" },
    ] : [];
    // The temperatures and fans (none: no row), the hottest over them.
    in property <string> sensors-summary: Platform.uses-mock-data ? "52 °C" : "";
    in property <[SensorLine]> temperatures: Platform.uses-mock-data ? [
        { name: "CPU", value: "52 °C", level: 0.5, line: "M0 20 L50 12 L100 8", area: "M0 20 L50 12 L100 8 L100 30 L0 30 Z" },
        { name: "TZ01", value: "38 °C", level: 0.38, line: "M0 18 L100 18", area: "M0 18 L100 18 L100 30 L0 30 Z" },
    ] : [];
    in property <[FanLine]> fans: Platform.uses-mock-data ? [{ name: "FAN0", rpm: 2100 }] : [];
    in property <[MemorySegment]> memory: Platform.uses-mock-data ? [
        { weight: 30, color: #5b8cff },
        { weight: 0.5, color: #2fb6a3 },
        { weight: 0.3, color: #e58a3a },
        { weight: 0.8, color: #757575 },
    ] : [];
    in property <BatteryInfo> battery: Platform.uses-mock-data ? {
        present: true,
        level: 63,
        direction: 1,
        state: "Charging",
        time-left: "Sample: 46 min until full",
        ac: "AC adapter plugged in",
        facts: [{ label: "Charging at", value: "Sample" }, { label: "Energy", value: "Sample" }, { label: "Health", value: "Sample" }],
        identity: "Sample battery",
    } : {};
    // Slingshot's version.
    in property <string> app-version: Platform.uses-mock-data ? "0.0" : "";
    // The firmware clock: the date, the time under it.
    in property <string> date-time-text: Platform.uses-mock-data ? "Sample date\n12:00" : "";
    in property <bool> clock-settable: Platform.uses-mock-data;
    // Setting it: day, month, year, hour, minute.
    in-out property <bool> time-dialog-visible;
    in property <[int]> time-fields: [1, 1, 2026, 0, 0];
    callback open-time-dialog();
    callback time-step(int, int);
    // A number typed in a field.
    callback time-set(int, int);
    callback apply-time();
    // In slint-viewer, the dialog opens and closes (the Rust code replaces
    // these handlers).
    open-time-dialog => {
        if Platform.uses-mock-data {
            time-dialog-visible = true;
        }
    }
    apply-time => {
        if Platform.uses-mock-data {
            time-dialog-visible = false;
        }
    }
}

// A row's icon, on its tile.
component RowIcon inherits Rectangle {
    in property <string> kind;
    in property <color> tint;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: Theme.surface-strong;
    Icon {
        kind: root.kind;
        size: 18px;
        thickness: 2px;
        color: root.tint;
    }
}

// A row of the machine's list: an icon, what it is, the value.
export component InfoRow inherits Rectangle {
    in property <string> icon;
    in property <bool> good;
    // Something to look at: the icon in orange.
    in property <bool> warn;
    in property <string> label;
    in property <string> title;
    in property <string> detail;

    min-height: 60px;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }
    @children
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 20px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            RowIcon {
                kind: root.icon;
                tint: root.good ? Theme.good : root.warn ? Theme.orange : Theme.accent;
            }
        }
        Text {
            min-width: 120px;
            text: root.label;
            font-size: 15px;
            color: Theme.text-soft;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: right;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                font-size: 13px;
                color: Theme.text-muted;
                horizontal-alignment: right;
                wrap: word-wrap;
            }
        }
    }
}

// The charge level, with a gradient that moves right while charging and left
// while discharging.
component BatteryBar inherits Rectangle {
    in property <float> level;
    in property <int> direction;
    in property <color> fill;
    // Only animate while shown (animation-tick() redraws every frame).
    in property <bool> animate;

    height: 14px;
    border-radius: self.height / 2;
    background: Theme.surface-strong;

    Rectangle {
        x: 0;
        width: parent.width * clamp(root.level, 0, 100) / 100;
        border-radius: parent.border-radius;
        background: root.fill;
        clip: true;

        if root.animate && root.direction != 0: Rectangle {
            property <length> period: 96px;
            property <float> phase: mod(animation-tick(), 1600ms) / 1600ms;
            x: (root.direction > 0 ? phase - 1 : -phase) * period;
            width: parent.width + 2 * period;
            // Enough for the widest bar (a fixed count: `for` over a float
            // expression generates Rust that doesn't compile).
            for i in 24: Rectangle {
                x: i * period;
                width: period;
                background: @linear-gradient(90deg, #ffffff00 0%, #ffffff60 50%, #ffffff00 100%);
            }
        }
    }
}

// The battery's row: the level, the state, the bar, the measurements.
component BatteryRow inherits Rectangle {
    in property <BatteryInfo> info;
    in property <bool> animate;
    property <color> fill: info.low ? Theme.danger : info.direction > 0 ? Theme.good : Theme.accent;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }
    VerticalLayout {
        padding-left: 18px;
        padding-right: 20px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                RowIcon {
                    kind: root.info.direction > 0 ? "bolt" : "battery";
                    tint: root.fill;
                }
            }
            VerticalLayout {
                min-width: 120px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: @tr("Battery");
                    font-size: 15px;
                    color: Theme.text-soft;
                }
                // What it is: chemistry, model.
                if root.info.identity != "": Text {
                    text: root.info.identity;
                    font-size: 12px;
                    color: Theme.text-muted;
                    overflow: elide;
                    max-width: 200px;
                }
            }
            // No bar when the level is unknown: an empty one would read as 0 %.
            if root.info.level < 0: Rectangle { horizontal-stretch: 1; }
            if root.info.level >= 0: VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                BatteryBar {
                    height: 10px;
                    level: root.info.level;
                    direction: root.info.direction;
                    fill: root.fill;
                    animate: root.animate;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                min-width: 150px;
                Text {
                    text: (root.info.level >= 0 ? @tr("{} %", round(root.info.level)) + " · " : "") + root.info.state;
                    font-size: 15px;
                    font-weight: 600;
                    color: root.info.low ? Theme.danger : Theme.text;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.info.time-left != "" ? root.info.time-left : root.info.ac;
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
            }
        }
        // The measurements.
        if root.info.facts.length > 0: HorizontalLayout {
            padding-left: 48px;
            spacing: 20px;
            alignment: start;
            for fact in root.info.facts: VerticalLayout {
                spacing: 1px;
                Text {
                    text: fact.label;
                    font-size: 11px;
                    color: Theme.text-muted;
                }
                Text {
                    text: fact.value;
                    font-size: 13px;
                    color: Theme.text-soft;
                }
            }
        }
    }
}

// Cool to hot, along the gauges: the theme's colors.
global Heat {
    out property <color> cool: Theme.accents[1];
    out property <color> warm: Theme.orange;
    out property <color> hot: Theme.danger;
}

// A temperature's gauge: a bar filled from cool to hot, `level` of the way.
component Gauge inherits Rectangle {
    in property <float> level;
    height: 8px;
    border-radius: self.height / 2;
    background: Theme.surface-strong;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * root.level;
        animate width { duration: Theme.motion ? 600ms : 0ms; easing: ease-out; }
        border-radius: parent.border-radius;
        clip: true;
        // The whole gradient, of which the bar shows its part.
        Rectangle {
            x: 0;
            width: root.width;
            background: @linear-gradient(90deg, Heat.cool 0%, Heat.warm 65%, Heat.hot 100%);
        }
    }
}

// The last minutes of a temperature: its line, the area under it fading.
component Sparkline inherits Rectangle {
    in property <string> line;
    in property <string> area;
    in property <color> tint;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 30;
        commands: root.area;
        fill: @linear-gradient(180deg, root.tint.with-alpha(0.35) 0%, root.tint.with-alpha(0) 100%);
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 30;
        commands: root.line;
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// A fan whose three blades turn, faster with its speed: a step every 80 ms
// (the real speed would only flicker, and each step draws the path again).
// Under 60° a step (the blades repeat every 120°), or a fast fan would seem
// to slow down, then turn backwards.
component FanGlyph inherits Rectangle {
    in property <int> rpm;
    in property <bool> animate;
    in property <color> tint;
    property <angle> spin;
    Timer {
        interval: 80ms;
        running: root.animate;
        // 15° a step at 1500 RPM, 36° at most.
        triggered => { root.spin = mod(root.spin + min(root.rpm / 1500 * 15deg, 36deg), 360deg); }
    }
    function blade(a: angle) -> string {
        "M12 12 Q" + (12 + 8 * cos(a - 35deg)) + " " + (12 + 8 * sin(a - 35deg))
            + " " + (12 + 9.5 * cos(a)) + " " + (12 + 9.5 * sin(a))
            + " Q" + (12 + 4 * cos(a + 30deg)) + " " + (12 + 4 * sin(a + 30deg)) + " 12 12 Z "
    }
    width: 24px;
    height: 24px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: root.blade(root.spin) + root.blade(root.spin + 120deg) + root.blade(root.spin + 240deg);
    }
    Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.surface;
        border-width: 1.5px;
        border-color: root.tint;
    }
}

// A line under the sensors' header: the name, then what it shows.
component SensorLineRow inherits HorizontalLayout {
    in property <string> name;
    padding-left: 48px;
    spacing: 14px;
    height: 30px;
    Text {
        width: 106px;
        text: root.name;
        font-size: 13px;
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

// The temperatures and fans: a gauge, the value and a graph per
// temperature, a turning fan per fan.
component SensorsRow inherits Rectangle {
    in property <bool> animate;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }
    VerticalLayout {
        padding-left: 18px;
        padding-right: 20px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                RowIcon {
                    kind: "thermometer";
                    tint: Theme.accent;
                }
            }
            Text {
                min-width: 120px;
                text: @tr("Temperatures");
                font-size: 15px;
                color: Theme.text-soft;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: System.sensors-summary;
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        for t in System.temperatures: SensorLineRow {
            name: t.name;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Gauge { level: t.level; }
            }
            Text {
                width: 56px;
                text: t.value;
                font-size: 14px;
                font-weight: 600;
                color: t.hot ? Heat.hot : Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Sparkline {
                width: 120px;
                line: t.line;
                area: t.area;
                tint: t.hot ? Heat.hot : t.level > 0.65 ? Heat.warm : Heat.cool;
            }
        }
        // The fans, side by side.
        if System.fans.length > 0: SensorLineRow {
            name: @tr("Fans");
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 28px;
                alignment: start;
                for f in System.fans: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        FanGlyph {
                            rpm: f.rpm;
                            animate: root.animate && f.rpm > 0;
                            tint: Theme.accent;
                        }
                    }
                    Text {
                        text: f.name;
                        font-size: 13px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("{} RPM", f.rpm);
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// The firmware clock, with its Change button.
component ClockCard inherits Panel {
    in property <string> text;
    in property <bool> can-change;
    // Changed to give the Change button the keyboard focus.
    in property <int> focus-request;
    callback change();
    changed focus-request => {
        if root.can-change {
            change.focus();
        }
    }


    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Icon {
                kind: "clock";
                size: 16px;
                thickness: 2px;
                color: Theme.text-muted;
            }
            Text {
                text: @tr("Date and time");
                font-size: 13px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.text;
            font-size: 20px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        change := Button {
            visible: root.can-change;
            height: root.can-change ? 44px : 0px;
            text: @tr("Change…");
            clicked => { root.change(); }
        }
    }
}

export component SystemScreen inherits Rectangle {
    // The screen is shown: the battery's gradient moves.
    in property <bool> active;
    in property <bool> can-change-time;
    // A dialog is over it: nothing to animate.
    in property <bool> covered;
    // The list doesn't fit: PgUp and PgDn scroll it.
    out property <bool> scrolls: list.scrolls;
    // PgUp and PgDn, wherever the keyboard focus is.
    public function page(down: bool) {
        list.page(down);
    }
    callback change-time();
    // Entering the screen: the keyboard focus on the Change button.
    property <int> focus-request;
    public function enter() {
        root.focus-request += 1;
    }

    HorizontalLayout {
        padding-top: 32px;
        padding-left: 64px;
        padding-right: 64px;
        padding-bottom: 20px;
        spacing: 28px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 18px;
            alignment: start;
            Panel {
                VerticalLayout {
                    // As the rows' contents.
                    HorizontalLayout {
                        padding-left: 20px;
                        Text {
                            text: @tr("This machine");
                            font-size: 22px;
                            font-weight: 600;
                            color: Theme.text;
                            height: 64px;
                            vertical-alignment: center;
                        }
                    }
                    // The rows scroll when they don't fit (a laptop's many
                    // temperatures, a small screen): the wheel, the bar.
                    list := ScrollList {
                        min-height: 64px;
                        preferred-height: rows.preferred-height;
                        content-height: rows.preferred-height;
                        rows := VerticalLayout {
                            width: list.width;
                            for item[i] in System.items: InfoRow {
                                icon: item.icon;
                                good: item.good;
                                label: item.label;
                                title: item.title;
                                detail: item.detail;
                                // The memory: how it's used (the memory map).
                                if item.icon == "memory" && System.memory.length > 0: Rectangle {
                                    x: 18px + 34px + 14px + 120px + 14px;
                                    width: parent.width * 0.26;
                                    height: 10px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 5px;
                                    clip: true;
                                    HorizontalLayout {
                                        spacing: 2px;
                                        for segment in System.memory: Rectangle {
                                            horizontal-stretch: segment.weight;
                                            min-width: 3px;
                                            background: segment.color;
                                        }
                                    }
                                }
                            }
                            if System.battery.present: BatteryRow {
                                info: System.battery;
                                animate: root.active && self.y + self.height + list.content-y > 0 && self.y + list.content-y < list.height;
                            }
                            if System.temperatures.length > 0 || System.fans.length > 0: SensorsRow {
                                // Not scrolled out of view.
                                animate: root.active && !root.covered && Theme.motion && self.y + self.height + list.content-y > 0 && self.y + list.content-y < list.height;
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            width: root.width < 1200px ? 260px : 300px;
            spacing: 16px;
            alignment: start;
            if System.date-time-text != "": ClockCard {
                text: System.date-time-text;
                can-change: root.can-change-time;
                focus-request: root.focus-request;
                change => { root.change-time(); }
            }
            Panel {
                HorizontalLayout {
                    padding: 18px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            kind: "power";
                            thickness: 2px;
                            color: Theme.accent;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: @tr("Slingshot");
                            font-size: 16px;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        if System.app-version != "": Text {
                            text: System.app-version;
                            font-size: 13px;
                            color: Theme.text-muted;
                        }
                    }
                }
            }
            // The standard "About Slint" widget, quieter than the machine's
            // details.
            Panel {
                VerticalLayout {
                    alignment: center;
                    padding: 8px;
                    AboutSlint { opacity: 0.6; }
                }
            }
        }
    }
}
