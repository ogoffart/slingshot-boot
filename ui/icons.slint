// Line icons drawn as paths on a 24×24 grid, so they stay sharp at any
// scale factor. `kind` matches the kinds produced by `bootvars.rs`.

export component Icon inherits Path {
    in property <string> kind;
    in property <color> color: #cfcfcf;
    in property <length> size: 24px;
    in property <length> thickness: 1.7px;

    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: thickness;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: kind == "linux" ? "M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M7 9l3 3l-3 3 M13 15h4"
        : kind == "windows" ? "M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M3 9h18 M6 6.5h1 M9 6.5h1"
        : kind == "usb" ? "M10 2h4a1 1 0 0 1 1 1v5H9V3a1 1 0 0 1 1-1z M6 8h12v10a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4z M11 4.5h0.5 M13 4.5h0.5"
        : kind == "network" ? "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M3 12h18 M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0 -18"
        : kind == "shell" ? "M8 6l-5 6l5 6 M16 6l5 6l-5 6"
        : kind == "disc" ? "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M10 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"
        : kind == "app" ? "M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z"
        : kind == "restart" ? "M20 12a8 8 0 1 1 -2.4 -5.7 M20 4v5h-5"
        : kind == "power" ? "M12 3v8 M6.3 6.8a8 8 0 1 0 11.4 0"
        : kind == "sliders" ? "M4 7h10 M18 7h2 M14 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M4 17h2 M10 17h10 M6 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"
        : kind == "shield-on" ? "M12 3l7 3v6c0 4.5 -3 7.5 -7 9c-4 -1.5 -7 -4.5 -7 -9V6z M9 12l2 2l4 -4"
        : kind == "shield-off" ? "M12 3l7 3v6c0 4.5 -3 7.5 -7 9c-4 -1.5 -7 -4.5 -7 -9V6z M9.5 9.5l5 5 M14.5 9.5l-5 5"
        : kind == "chevron-down" ? "M6 9l6 6l6 -6"
        : kind == "chevron-up" ? "M6 15l6 -6l6 6"
        : kind == "chevron-left" ? "M15 6l-6 6l6 6"
        : kind == "chevron-right" ? "M9 6l6 6l-6 6"
        : kind == "more" ? "M4 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0 M10.5 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0 M17 12a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0"
        : kind == "back" ? "M19 12H5 M11 6l-6 6l6 6"
        : kind == "folder" ? "M3 7a2 2 0 0 1 2 -2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2z"
        : kind == "eye" ? "M2.5 12c1.5 -3.5 5 -7 9.5 -7s8 3.5 9.5 7c-1.5 3.5 -5 7 -9.5 7s-8 -3.5 -9.5 -7z M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"
        : kind == "eye-off" ? "M3 3l18 18 M10.6 10.6a2 2 0 0 0 2.8 2.8 M9.9 5.1a9.5 9.5 0 0 1 2.1 -.1c5 0 8.5 4.5 9.5 7c-.4 1 -1.2 2.3 -2.3 3.4 M6.6 6.6c-1.9 1.3 -3.3 3.2 -4.1 5.4c1 2.5 4.5 7 9.5 7c1.8 0 3.4 -.6 4.8 -1.4"
        : kind == "lock" ? "M6 11h12a1 1 0 0 1 1 1v8a1 1 0 0 1 -1 1H6a1 1 0 0 1 -1 -1v-8a1 1 0 0 1 1 -1z M8 11V7a4 4 0 0 1 8 0v4 M12 15v2"
        : kind == "apple" ? "M15.5 3c-1.2 .1 -2.5 .8 -3.2 1.9c-.6 .9 -.9 2 -.7 3c1.2 .1 2.5 -.6 3.2 -1.7c.6 -.9 .9 -2 .7 -3.2z M12 8.6c-.9 0 -2.2 -.8 -3.4 -.8c-2.4 0 -4.6 2 -4.6 5.4c0 3.6 2.6 8.3 4.6 8.3c1.1 0 1.6 -.7 3.4 -.7s2.2 .7 3.4 .7c1.9 0 3.6 -3.2 4.2 -5c-1.8 -.8 -2.8 -2.5 -2.8 -4.3c0 -1.5 .7 -2.9 1.9 -3.7c-.9 -1.1 -2.2 -1.8 -3.5 -1.8c-1.1 0 -2.2 .8 -3.2 .8z"
        : kind == "battery" ? "M3 8a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2z M22 10v4"
        : kind == "plug" ? "M9 3v5 M15 3v5 M6 8h12v3a6 6 0 0 1 -12 0z M12 17v4"
        : kind == "bolt" ? "M13 3l-7 10h5l-1 8l7 -10h-5z"
        : kind == "picture" ? "M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2V6a2 2 0 0 1 2 -2z M3 16l5 -5l4 4l3 -3l6 6 M15 9a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"
        : kind == "palette" ? "M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.58 9 8c0 2.5 -2 4 -4.5 4h-2a1.5 1.5 0 0 0 -1 2.6a1.5 1.5 0 0 1 -1.5 3.4z M7.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M15.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"
        : kind == "play" ? "M7 4v16l13 -8z"
        : kind == "display" ? "M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1H4a1 1 0 0 1 -1 -1z M8 20h8 M12 16v4"
        : kind == "keyboard" ? "M3 7a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1H4a1 1 0 0 1 -1 -1z M7 10h0.01 M11 10h0.01 M15 10h0.01 M7 14h0.01 M17 10h0.01 M9 14h6 M17 14h0.01"
        : kind == "list" ? "M9 6h11 M9 12h11 M9 18h11 M5 6h0.01 M5 12h0.01 M5 18h0.01"
        : kind == "cpu" ? "M6 6h12v12H6z M10 10h4v4h-4z M9 2v4 M15 2v4 M9 18v4 M15 18v4 M2 9h4 M2 15h4 M18 9h4 M18 15h4"
        : kind == "memory" ? "M3 8h18v8H3z M7 11v2 M11 11v2 M15 11v2 M6 16v3 M18 16v3"
        : kind == "computer" ? "M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1 -1 1H7a1 1 0 0 1 -1 -1V4a1 1 0 0 1 1 -1z M10 7h4 M10 11h4 M12 17h0.01"
        : kind == "firmware" ? "M5 4h14v16H5z M9 8h6 M9 12h6 M9 16h3"
        : kind == "clock" ? "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 7v5l3 3"
        : kind == "grip" ? "M9 5v1 M15 5v1 M9 11.5v1 M15 11.5v1 M9 18v1 M15 18v1"
        // Generic disk (cylinder), also the fallback.
        : "M4 7a8 3 0 1 0 16 0a8 3 0 1 0 -16 0 M4 7v10a8 3 0 0 0 16 0V7";
}
