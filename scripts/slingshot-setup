c2f26210a547a20e9864ca6d0aee3101b61dc6803d2d8cf556d5c6dbd57f8e49  udf_aa64.efi
8c126fb13d7b7dc2525ba82cc72819dfdb7ef64a63fcaf0ff6a882458be2df76  udf_x64.efi
3eba059cda2b17365c5fc6d99accf5619e68e519ad90317a49d35126dd74753c  xfs_aa64.efi
e6634e30fa66416a617b039142cc90f8478f287143e978f013c0eb0ed7268dee  xfs_x64.efi
6fd41657b155af441463ee4122abfeb7eee07a14152a4145489438def8e8fe4c  zfs_aa64.efi
83b8eaa89435e1023b128d283caea6ecd5907f033bb952288474ece7b0440562  zfs_x64.efi
"

# EfiFs's driver for a file system type ("" if it has none).
efifs_name() { # fstype
    case $1 in
        ext2 | ext3 | ext4) echo "ext2_$EFI_ARCH.efi" ;;
        btrfs | xfs | f2fs | zfs | jfs | reiserfs | hfsplus | iso9660 | ntfs | exfat | udf) echo "${1}_$EFI_ARCH.efi" ;;
        ntfs3) echo "ntfs_$EFI_ARCH.efi" ;;
    esac
}

# The expected SHA-256 of an EfiFs driver (SLINGSHOT_EFIFS_SUMS: a file of
# other sums, for the tests).
efifs_sum() { # name
    local sums=$EFIFS_SUMS
    [ -z "${SLINGSHOT_EFIFS_SUMS:-}" ] || sums=$(cat "$SLINGSHOT_EFIFS_SUMS")
    printf '%s\n' "$sums" | awk -v n="$1" '$2 == n { print $1 }'
}

# Downloads an EfiFs driver into the file $2, and checks it.
fetch_efifs() { # name file
    local expected actual
    expected=$(efifs_sum "$1")
    [ -n "$expected" ] || return 1
    command -v curl >/dev/null || { warn "curl is needed to download it."; return 1; }
    if ! curl -fsSL --retry 3 --proto '=https,file' -o "$2" "$EFIFS_URL/$1"; then
        warn "Couldn't download $EFIFS_URL/$1"
        warn "Try again later: slingshot-setup drivers"
        return 1
    fi
    actual=$(sha256sum "$2" | cut -d' ' -f1)
    if [ "$actual" != "$expected" ]; then
        warn "$1 isn't the expected file (SHA-256 $actual): not installed."
        return 1
    fi
}

# Whether to sign what's installed with sbctl: --sign, or Secure Boot on
# with sbctl there.
should_sign() {
    [ "$SIGN" = 1 ] || { secure_boot_enabled && command -v sbctl >/dev/null; }
}

# Where rEFInd's drivers are on this system: its package's folder, or an
# installed rEFInd's (SLINGSHOT_REFIND_DRIVERS overrides it, for the tests).
find_drivers_dir() { # esp
    local d
    for d in ${SLINGSHOT_REFIND_DRIVERS:-} \
        "/usr/share/refind/drivers_$EFI_ARCH" \
        "/usr/share/refind/refind/drivers_$EFI_ARCH" \
        "$1/EFI/refind/drivers_$EFI_ARCH"; do
        if root_dir "$d"; then
            echo "$d"
            return
        fi
    done
}

# Copies the drivers Slingshot needs to read the kernels' file systems:
# rEFInd's from its package, else EfiFs's, downloaded and checked.
add_drivers() { # esp
    local esp=$1 fs name efifs dir target tmp
    target="$esp/$ESP_DIR/drivers"
    dir=$(find_drivers_dir "$esp")
    for fs in $(kernel_filesystems); do
        case $fs in vfat | "") continue ;; esac
        name=$(driver_name "$fs")
        efifs=$(efifs_name "$fs")
        if [ -z "$name" ] && [ -z "$efifs" ]; then
            warn "Your kernels are on $fs: Slingshot has no driver for it, so it shows the"
            warn "boot loader's entries but can't find kernels there by itself."
            continue
        fi
        if { [ -n "$name" ] && root_exists "$target/$name"; } || { [ -n "$efifs" ] && root_exists "$target/$efifs"; }; then
            ok "Driver for $fs: already there"
            continue
        fi
        if [ -n "$name" ] && [ -n "$dir" ] && root_exists "$dir/$name"; then
            if ask "Your kernels are on $fs. Add rEFInd's $fs driver, so that Slingshot finds them by itself?"; then
                as_root mkdir -p "$target"
                as_root cp "$dir/$name" "$target/$name"
                ok "Added $target/$name"
                if should_sign; then
                    # Only a package's driver: one on the EFI System Partition
                    # could have been put there by anyone who can write there
                    # (another system, a USB boot), and signing it would make
                    # the firmware trust it.
                    case $dir in
                        "$esp"/*)
                            warn "Not signed: it comes from the EFI System Partition, which anyone with"
                            warn "access to it can change. Install rEFInd's package, or check the file"
                            warn "and sign it yourself: sbctl sign -s $target/$name"
                            ;;
                        *) sign_file "$target/$name" ;;
                    esac
                fi
            fi
            continue
        fi
        [ -n "$efifs" ] || continue
        if ask "Your kernels are on $fs. Download EfiFs's $fs driver (github.com/pbatard/efifs, v$EFIFS_VERSION), so that Slingshot finds them by itself?"; then
            if [ "$DRY_RUN" = 1 ]; then
                printf '    %s[dry run]%s download %s, check its SHA-256\n' "$DIM" "$RESET" "$EFIFS_URL/$efifs"
                as_root mkdir -p "$target"
                as_root cp "$efifs" "$target/$efifs"
                ! should_sign || sign_file "$target/$efifs"
                continue
            fi
            tmp=$(mktemp)
            if fetch_efifs "$efifs" "$tmp"; then
                as_root mkdir -p "$target"
                as_root cp "$tmp" "$target/$efifs"
                ok "Added $target/$efifs (SHA-256 checked)"
                ! should_sign || sign_file "$target/$efifs"
            fi
            rm -f "$tmp"
        fi
    done
}

# Signs a file with sbctl, which signs it again after updates (-s).
sign_file() { # file
    command -v sbctl >/dev/null || die "--sign needs sbctl, with your keys enrolled (sbctl create-keys, sbctl enroll-keys)."
    as_root sbctl sign -s "$1"
    ok "Signed $1 with sbctl"
}

# --- commands ----------------------------------------------------------------

cmd_drivers() {
    require_uefi
    local esp
    esp=$(find_esp)
    root_exists "$esp/$ESP_DIR/$EFI_NAME" || die "Slingshot isn't installed yet: run 'slingshot-setup install' first."
    step "File system drivers"
    add_drivers "$esp"
}

cmd_luks_entry() {
    local esp
    esp=$(find_esp)
    command -v mkinitcpio >/dev/null || die "only mkinitcpio is supported (Arch Linux): for others, see $DOCS/encrypted-disks.md"
    switch_to_sd_encrypt "$esp"
    offer_cryptsetup
    step "An entry Slingshot can unlock the encrypted disk for"
    if secure_boot_enabled; then
        warn "Secure Boot is on: this entry's initramfs isn't signed, the unified image's is."
        ask "Add it anyway?" || { finish_sd_encrypt "$esp"; exit 0; }
    fi
    add_unlock_entries "$esp"
    finish_sd_encrypt "$esp"
}

# For packages: after an upgrade, copy the new slingshot.efi over the
# installed one (and sign it again with sbctl if it was signed). Does
# nothing when Slingshot isn't installed.
cmd_update() {
    require_uefi
    local esp target
    esp=$(find_esp)
    target="$esp/$ESP_DIR/$EFI_NAME"
    if ! root_exists "$target"; then
        info "Slingshot isn't installed on $esp: nothing to update."
        return
    fi
    find_efi_file
    if cmp -s "$EFI_FILE" "$target"; then
        ok "Already up to date: $target"
        return
    fi
    local signed=""
    if command -v sbctl >/dev/null && sbctl list-files 2>/dev/null | grep -qF "$target"; then
        signed=1
    fi
    # Copied and signed next to it, then renamed: a power cut or a failed
    # signature leaves the working one in place.
    as_root cp "$EFI_FILE" "$target.new"
    if [ -n "$signed" ] && ! as_root sbctl sign "$target.new"; then
        as_root rm -f "$target.new"
        die "Couldn't sign the new $target with sbctl: kept the one there is."
    fi
    as_root mv "$target.new" "$target"
    as_root sync
    ok "Updated $target"
    if [ -n "$signed" ]; then
        ok "Signed again with sbctl"
    fi
}

cmd_install() {
    require_uefi
    find_efi_file
    local esp
    esp=$(find_esp)

    step "Installing $LABEL"
    info "EFI System Partition: $esp"
    as_root mkdir -p "$esp/$ESP_DIR"
    as_root cp "$EFI_FILE" "$esp/$ESP_DIR/$EFI_NAME"
    ok "Copied to $esp/$ESP_DIR/$EFI_NAME"
    write_keymap "$esp/$ESP_DIR" || write_console_keymap "$esp/$ESP_DIR" || write_keyboard_layout "$esp/$ESP_DIR"
    write_language "$esp/$ESP_DIR"
    add_wallpapers "$esp/$ESP_DIR"

    if [ "$SIGN" = 1 ]; then
        step "Signing for Secure Boot"
        sign_file "$esp/$ESP_DIR/$EFI_NAME"
    elif secure_boot_enabled; then
        step "Secure Boot is on"
        if command -v sbctl >/dev/null && ask "Sign Slingshot with your sbctl keys?"; then
            # Then the drivers too.
            SIGN=1
            sign_file "$esp/$ESP_DIR/$EFI_NAME"
        else
            warn "The firmware will refuse to start an unsigned Slingshot."
            warn "Sign it (sbctl sign -s $esp/$ESP_DIR/$EFI_NAME) or turn Secure Boot off in the firmware setup."
        fi
    fi

    step "Firmware boot entry"
    local num
    num=$(boot_entries | entry_number)
    if [ -n "$num" ]; then
        ok "Already there: Boot$num"
    else
        local disk part
        read -r disk part <<<"$(esp_disk_and_partition "$esp")"
        # --create-only: add the entry without putting it in BootOrder, so
        # what boots by default doesn't change.
        as_root efibootmgr --quiet --create-only --disk "$disk" --part "$part" \
            --label "$LABEL" --loader "\\${ESP_DIR//\//\\}\\$EFI_NAME"
        num=$(boot_entries | entry_number)
        ok "Created ${num:+Boot$num }(not the default yet)"
    fi

    if uses_systemd_boot "$esp"; then
        info "systemd-boot found: Slingshot will show its entries (Arch Linux, …) as cards."
    fi

    step "File system drivers"
    add_drivers "$esp"

    # An entry to add: a unified image, an encrypted disk.
    local pending=""
    if opens_luks "$(uki_cmdline)"; then pending=$(pending_entries "$esp"); fi
    if [ -n "$pending" ]; then
        step "Unified kernel image with an encrypted disk"
        if secure_boot_enabled; then
            info "Secure Boot is on: an entry for Slingshot to ask for the passphrase would"
            info "have an unsigned initramfs. To add it anyway: slingshot-setup luks-entry"
        elif ask "Add a boot entry, $(awk '{ print $5 }' <<<"$pending" | paste -sd ' '), for Slingshot to ask for the passphrase?"; then
            add_unlock_entries "$esp" "$pending"
        else
            info "Later: slingshot-setup luks-entry"
        fi
    fi
    if encrypt_hooks >/dev/null; then
        info "Tip: with sd-encrypt rather than encrypt, Linux doesn't derive the key again:"
        info "slingshot-setup luks-entry offers to switch."
    fi

    printf '\n%sDone.%s Nothing boots differently yet. Next:\n' "$GREEN" "$RESET"
    info "${BOLD}slingshot-setup try${RESET}           start Slingshot once, on the next restart"
    info "${BOLD}slingshot-setup make-default${RESET}  start Slingshot on every boot"
}

cmd_try() {
    require_uefi
    local num
    num=$(boot_entries | entry_number)
    [ -n "$num" ] || die "Slingshot isn't installed yet: run 'slingshot-setup install' first."
    step "Starting Slingshot once, on the next restart"
    as_root efibootmgr --quiet --bootnext "$num"
    ok "BootNext = $num. The restart after that goes back to normal, whatever happens."
    if [ "$NO_RESTART" = 0 ] && ask "Restart now?"; then
        as_root systemctl reboot
    else
        info "Restart when you're ready."
    fi
}

cmd_make_default() {
    require_uefi
    local entries num order rest new
    entries=$(boot_entries)
    num=$(entry_number <<<"$entries")
    [ -n "$num" ] || die "Slingshot isn't installed yet: run 'slingshot-setup install' first."
    order=$(boot_order <<<"$entries")
    rest=$(boot_order_without "$order" "$num")
    new="$num${rest:+,$rest}"
    step "Making Slingshot the default"
    info "Boot order now: $order"
    info "Boot order new: $new"
    if ask "Change the boot order?"; then
        as_root efibootmgr --quiet --bootorder "$new"
        ok "Slingshot starts on every boot. It boots your previous default after its countdown."
        local esp
        esp=$(find_esp)
        if uses_systemd_boot "$esp" && ! root_cat "$esp/loader/loader.conf" | grep -qE '^\s*timeout\s+0\b'; then
            info "Tip: set 'timeout 0' in $esp/loader/loader.conf so systemd-boot doesn't show"
            info "its own menu after Slingshot's (hold a key at power-on to get it anyway)."
        fi
    fi
}

cmd_undefault() {
    require_uefi
    local entries num rest
    entries=$(boot_entries)
    num=$(entry_number <<<"$entries")
    [ -n "$num" ] || die "Slingshot isn't installed."
    rest=$(boot_order_without "$(boot_order <<<"$entries")" "$num")
    step "Removing Slingshot from the boot order"
    if [ -n "$rest" ]; then
        as_root efibootmgr --quiet --bootorder "$rest"
        ok "Boot order: $rest (the entry is kept, so 'try' still works)"
    else
        as_root efibootmgr --quiet --delete-bootorder
        ok "Boot order removed (the entry is kept, so 'try' still works)"
    fi
}

cmd_systemd_boot_entry() {
    local esp
    esp=$(find_esp)
    uses_systemd_boot "$esp" || die "systemd-boot isn't installed on $esp."
    root_exists "$esp/$ESP_DIR/$EFI_NAME" || die "Slingshot isn't installed yet: run 'slingshot-setup install' first."
    step "Adding Slingshot to systemd-boot's menu"
    printf 'title %s\nefi /%s/%s\n' "$LABEL" "$ESP_DIR" "$EFI_NAME" | root_write "$esp/$LOADER_ENTRY"
    ok "Added $esp/$LOADER_ENTRY"
}

cmd_status() {
    require_uefi
    QUIET_SUDO=1
    local esp entries num order
    esp=$(find_esp)
    entries=$(boot_entries)
    num=$(entry_number <<<"$entries")
    order=$(boot_order <<<"$entries")
    if [ "$PORCELAIN" = 1 ]; then
        status_porcelain "$esp" "$num" "$order"
        return
    fi
    step "Slingshot status"
    info "EFI System Partition: $esp"
    if root_exists "$esp/$ESP_DIR/$EFI_NAME"; then ok "Installed: $esp/$ESP_DIR/$EFI_NAME"; else warn "Not installed"; fi
    if [ -n "$num" ]; then
        ok "Firmware entry: Boot$num"
        case $(order_place "$num" "$order") in
            first) ok "Default: starts on every boot" ;;
            later) info "In the boot order, not first" ;;
            *) info "Not in the boot order (start it with 'slingshot-setup try')" ;;
        esac
    else
        warn "No firmware entry"
    fi
    if root_exists "$esp/$LOADER_ENTRY"; then ok "In systemd-boot's menu"; fi
    if secure_boot_enabled; then warn "Secure Boot is on: Slingshot must be signed"; else info "Secure Boot is off"; fi
    if uses_systemd_boot "$esp"; then info "Boot loader: systemd-boot"; fi
}

# `status --porcelain`: key=value lines, for the desktop app's Install panel.
status_porcelain() {
    local esp=$1 num=$2 order=$3
    printf 'esp=%s\n' "$esp"
    printf 'installed=%s\n' "$(flag root_exists "$esp/$ESP_DIR/$EFI_NAME")"
    printf 'file=%s\n' "$esp/$ESP_DIR/$EFI_NAME"
    printf 'entry=%s\n' "$num"
    printf 'order=%s\n' "$(order_place "$num" "$order")"
    printf 'systemd_boot=%s\n' "$(flag uses_systemd_boot "$esp")"
    printf 'systemd_boot_entry=%s\n' "$(flag root_exists "$esp/$LOADER_ENTRY")"
    printf 'secure_boot=%s\n' "$(flag secure_boot_enabled)"
}

# 1 when the command succeeds, else 0.
flag() { if "$@"; then echo 1; else echo 0; fi; }

# Where the entry $1 is in the boot order $2: first, later or none.
order_place() { # num order
    [ -n "$1" ] || { echo none; return; }
    case ",$2," in
        ",$1,"*) echo first ;;
        *",$1,"*) echo later ;;
        *) echo none ;;
    esac
}

cmd_uninstall() {
    require_uefi
    local esp num
    esp=$(find_esp)
    num=$(boot_entries | entry_number)
    step "Uninstalling Slingshot"
    info "Tip: Slingshot's own settings are only visible to firmware programs; use"
    info "Settings → Reset all settings in Slingshot first if you want them gone too."
    ask "Remove Slingshot?" || exit 0
    if [ -n "$num" ]; then
        as_root efibootmgr --quiet --delete-bootnum --bootnum "$num"
        ok "Removed firmware entry Boot$num"
    fi
    if root_exists "$esp/$LOADER_ENTRY"; then
        as_root rm -f "$esp/$LOADER_ENTRY"
        ok "Removed the systemd-boot entry"
    fi
    remove_luks_entries "$esp"
    if root_dir "$esp/$ESP_DIR"; then
        as_root rm -rf "$esp/$ESP_DIR"
        ok "Removed $esp/$ESP_DIR"
    fi
}

cmd_password() {
    # Prints the slingshot.toml lines that lock the Settings screen.
    command -v sha256sum >/dev/null || die "sha256sum not found"
    local pw pw2
    read -r -s -p "Password for Slingshot's Settings: " pw; echo
    read -r -s -p "Again: " pw2; echo
    [ "$pw" = "$pw2" ] || die "the passwords differ"
    [ -n "$pw" ] || die "empty password"
    local hash
    hash=$(printf '%s' "$pw" | sha256sum | cut -d' ' -f1)
    step "Add these lines to slingshot.toml (next to slingshot.efi):"
    printf '\n[settings]\naccess = "password"\npassword = "sha256:%s"\n\n' "$hash"
    info "Keyboard layouts differ in the firmware: prefer letters and digits."
}

usage() {
    cat <<EOF
${BOLD}slingshot-setup${RESET} — install Slingshot next to your boot loader

${BOLD}Usage:${RESET} slingshot-setup [options] <command>

${BOLD}Commands:${RESET}
  install              build (if needed), copy to the EFI System Partition and add
                       a firmware entry, without changing what boots by default
  try                  start Slingshot once, on the next restart
  make-default         start Slingshot on every boot
  undefault            stop starting Slingshot by default (keeps it installed)
  systemd-boot-entry   also add Slingshot to systemd-boot's menu
  luks-entry           with a unified kernel image and an encrypted disk: add an
                       entry with the kernel and initramfs as separate files, so
                       that Slingshot asks for the passphrase; and from the
                       encrypt hook to sd-encrypt, so that Linux takes the key
                       Slingshot found (mkinitcpio)
  drivers              add the drivers Slingshot needs to read the partitions
                       with your kernels (ext4, btrfs, XFS…: rEFInd's package's,
                       else EfiFs's, downloaded and checked)
  password             print the slingshot.toml lines that lock Settings
  update               copy a newer slingshot.efi over the installed one (for packages)
  status               show what is installed
  uninstall            remove everything

${BOLD}Options:${RESET}
  --efi FILE   install this slingshot.efi instead of building it
  --no-sse     from the source tree, on a PC: build it without hardware
               floating point (by default it has it, as the releases: twice as
               fast, and needs Rust's rust-src component, which rustup adds)
  --sign       sign Slingshot and its drivers with your sbctl keys, for Secure
               Boot (without asking, even while Secure Boot is off)
  --program FILE  the slingshot program, for this system's keyboard layout
               (slingshot keymap; found next to this script or in PATH)
  --esp DIR    the EFI System Partition is mounted there (default: found)
  --yes, -y    don't ask for confirmation
  --dry-run    print the commands that change the system instead of running them
  --no-restart try: don't offer to restart
  --porcelain  status: key=value lines, for programs

Manual steps: $DOCS/install-manually.md
EOF
}

main() {
    local cmd=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --efi) EFI_FILE=${2:-}; shift ;;
            --sse) SSE=1 ;;
            --no-sse) SSE=0 ;;
            --sign) SIGN=1 ;;
            --program) SLINGSHOT_PROGRAM=${2:-}; shift ;;
            --esp) ESP=${2:-}; shift ;;
            --yes|-y) ASSUME_YES=1 ;;
            --dry-run) DRY_RUN=1 ;;
            --no-restart) NO_RESTART=1 ;;
            --porcelain) PORCELAIN=1 ;;
            -h|--help|help) usage; exit 0 ;;
            -*) die "unknown option $1 (see 'slingshot-setup help')" ;;
            *) [ -z "$cmd" ] || die "one command at a time"; cmd=$1 ;;
        esac
        shift
    done
    if [ "$SIGN" = 1 ] && ! command -v sbctl >/dev/null; then
        die "--sign needs sbctl, with your keys enrolled (sbctl create-keys, sbctl enroll-keys)."
    fi
    case "$cmd" in
        install) cmd_install ;;
        try) cmd_try ;;
        make-default) cmd_make_default ;;
        undefault) cmd_undefault ;;
        systemd-boot-entry) cmd_systemd_boot_entry ;;
        luks-entry) cmd_luks_entry ;;
        drivers) cmd_drivers ;;
        password) cmd_password ;;
        update) cmd_update ;;
        status) cmd_status ;;
        uninstall) cmd_uninstall ;;
        "") usage; exit 1 ;;
        *) die "unknown command '$cmd' (see 'slingshot-setup help')" ;;
    esac
}

main "$@"
