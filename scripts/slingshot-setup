#!/usr/bin/env bash
# Copyright © Olivier Goffart
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Installs Slingshot next to the existing boot loader on a Linux system.
# Run `slingshot-setup help` for the commands. Manual steps: docs/install-manually.md

set -euo pipefail

LABEL="Slingshot"
ESP_DIR="EFI/slingshot"
EFI_NAME="slingshot.efi"
LOADER_ENTRY="loader/entries/slingshot.conf"
# For what's shown to the user, and the comments written in their files.
DOCS="https://github.com/ogoffart/slingshot-boot/blob/master/docs"
# The first lines of what luks-entry writes, for uninstall to find them.
LUKS_ENTRY_MARK="# Written by slingshot-setup"
PRESET_MARK="# slingshot-setup: the initramfs as well"
GLOBAL_GUID="8be4df61-93ca-11d2-aa0d-00e098032b8c"
# The GPT partition type of an EFI System Partition.
ESP_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
# The tests' overrides, below, aren't for root: with `sudo -E`, they'd
# have root read and run the files of whoever set them. Unless the tests
# themselves run as root (they say so).
if [ "$(id -u)" = 0 ] && [ "${SLINGSHOT_TESTING:-}" != 1 ]; then
    unset SLINGSHOT_ARCH SLINGSHOT_SYSFS SLINGSHOT_ETC SLINGSHOT_REFIND_DRIVERS SLINGSHOT_EFIFS_URL SLINGSHOT_EFIFS_SUMS SLINGSHOT_HOME
fi
# The firmware's architecture: x64 or aa64 in EFI file names
# (SLINGSHOT_ARCH overrides it, for the tests).
case "${SLINGSHOT_ARCH:-$(uname -m)}" in
    aarch64 | arm64) EFI_ARCH=aa64 UEFI_TARGET=aarch64-unknown-uefi PE_MACHINE=aa64 ;;
    *) EFI_ARCH=x64 UEFI_TARGET=x86_64-unknown-uefi PE_MACHINE=8664 ;;
esac
# Where sysfs is: tests point it at a fake one.
SYS=${SLINGSHOT_SYSFS:-/sys}
ETC=${SLINGSHOT_ETC:-/etc}
# This script's folder: slingshot.efi and the slingshot program can be next to it.
HERE=$(cd "$(dirname "$0")" && pwd)

ASSUME_YES=0
DRY_RUN=0
NO_RESTART=0
PORCELAIN=0
EFI_FILE=""
ESP=""
# From the source tree on a PC: the build with hardware floating point (as
# the releases), unless --no-sse; 0 = no, 1 = asked, "" = if it can.
SSE=""
SIGN=0

# --- output ----------------------------------------------------------------

if [ -t 1 ]; then
    BOLD=$'\e[1m' DIM=$'\e[2m' RED=$'\e[31m' GREEN=$'\e[32m' YELLOW=$'\e[33m' BLUE=$'\e[34m' RESET=$'\e[0m'
else
    BOLD="" DIM="" RED="" GREEN="" YELLOW="" BLUE="" RESET=""
fi

step() { printf '%s==>%s %s%s%s\n' "$BLUE" "$RESET" "$BOLD" "$*" "$RESET"; }
info() { printf '    %s\n' "$*"; }
ok()   { printf '    %s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '    %s!%s %s\n' "$YELLOW" "$RESET" "$*"; }
die()  { printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }

ask() {
    # ask "Question?" → returns 0 for yes
    if [ "$ASSUME_YES" = 1 ]; then return 0; fi
    local answer
    printf '    %s [y/N] ' "$1"
    read -r answer || { echo; return 1; }
    [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
}

# The commands run as root are shown on fd 3, the script's standard
# output: not silenced with the command's own output (`as_root tee … >/dev/null`).
exec 3>&1

# Runs a command as root (through sudo when needed), showing it first, or
# only shows it with --dry-run.
as_root() {
    if [ "$DRY_RUN" = 1 ]; then
        printf '    %s[dry run]%s %s\n' "$DIM" "$RESET" "$*"
        return 0
    fi
    if [ "$EUID" = 0 ]; then
        printf '    %s# %s%s\n' "$DIM" "$(shown_command "$@")" "$RESET" >&3
        "$@"
    else
        printf '    %s$ sudo %s%s\n' "$DIM" "$(shown_command "$@")" "$RESET" >&3
        sudo "$@"
    fi
}

# A command as one would type it: arguments quoted when they need it.
shown_command() {
    local arg out=""
    for arg in "$@"; do
        case $arg in
            "" | *[!A-Za-z0-9_./:=@%+,-]*) arg="'${arg//\'/\'\\\'\'}'" ;;
        esac
        out+="${out:+ }$arg"
    done
    printf '%s' "$out"
}

# The ESP is often readable by root only (fmask=0077, dmask=0077): these
# look as root when the user can't. Without asking for a password for
# `status`, or a dry run without a terminal (the desktop app runs them).
QUIET_SUDO=0
# The presets mkinitcpio built (" linux linux-lts ").
BUILT=" "
# Said once, before sudo first asks for a password to read something.
SAID_WHY=0
as_root_quietly() {
    [ "$EUID" != 0 ] || return 1
    if [ "$QUIET_SUDO" = 1 ] || { [ "$DRY_RUN" = 1 ] && [ ! -t 0 ]; }; then
        sudo -n "$@" 2>/dev/null
    else
        if [ "$SAID_WHY" = 0 ] && ! sudo -n true 2>/dev/null; then
            info "Only root can read ${*: -1}: sudo asks for your password to read it."
            info "(Nothing is changed before you confirm.)"
            SAID_WHY=1
        fi
        sudo "$@" 2>/dev/null
    fi
}
# A command that only reads: as the user, else as root.
as_user_or_root() { "$@" 2>/dev/null || as_root_quietly "$@"; }
root_exists() { as_user_or_root test -e "$1"; }
root_dir() { as_user_or_root test -d "$1"; }
root_cat() { as_user_or_root cat "$1" || true; }
# A file root owns, that nobody else can write (nor its folder).
owned_by_root() { # file
    local f
    for f in "$1" "$(dirname "$1")"; do
        case "$(stat -Lc '%u %a' "$f" 2>/dev/null)" in
            "0 "*[2367]? | "0 "*[2367]) return 1 ;;
            "0 "*) ;;
            *) return 1 ;;
        esac
    done
}

# Writes stdin to the file $1 as root ($2 = -a: appends), or shows it with
# --dry-run (`as_root tee` would print the command and not read stdin).
root_write() { # file [-a]
    if [ "$DRY_RUN" = 1 ]; then
        printf '    %s[dry run]%s write %s:\n' "$DIM" "$RESET" "$1"
        sed 's/^/        /'
        return 0
    fi
    as_root tee ${2:-} "$1" >/dev/null
}

# The value of KEY=… (quotes removed) in the first of the files that has it.
conf_value() { # key file…
    local key=$1 f value
    shift
    for f in "$@"; do
        [ -f "$f" ] || continue
        value=$(sed -n "s/^$key=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$f" | tail -1)
        if [ -n "$value" ]; then
            printf '%s' "$value"
            return
        fi
    done
}

# --- detection -------------------------------------------------------------

require_uefi() {
    [ -d "$SYS/firmware/efi" ] || die "this system didn't boot in UEFI mode (no /sys/firmware/efi)."
    command -v efibootmgr >/dev/null || die "efibootmgr is needed: install it (Arch: pacman -S efibootmgr, Debian/Ubuntu: apt install efibootmgr)."
}

find_esp() {
    if [ -n "$ESP" ]; then
        [ -d "$ESP/EFI" ] || die "$ESP doesn't look like an EFI System Partition (no EFI folder)."
        printf '%s' "$ESP"
        return
    fi
    local esp="" m dev
    if command -v bootctl >/dev/null; then
        esp=$(bootctl --print-esp-path 2>/dev/null || true)
    fi
    # Without root: Ubuntu mounts it with umask=0077, only root sees inside.
    # Looking is enough to have systemd mount an automounted one ("autofs"
    # until then).
    if [ -z "$esp" ]; then
        for m in /efi /boot /boot/efi; do
            test -d "$m/EFI" 2>/dev/null || true
            if [ "$(findmnt -no FSTYPE "$m" 2>/dev/null | tail -n1)" = vfat ] && { [ -d "$m/EFI" ] || is_esp_partition "$m"; }; then
                esp=$m
                break
            fi
        done
    fi
    # Mounted elsewhere: the partition of the EFI System Partition's type.
    if [ -z "$esp" ]; then
        esp=$(lsblk -rno PARTTYPE,MOUNTPOINT 2>/dev/null |
            awk -v t="$ESP_TYPE" 'tolower($1) == t && $2 != "" { print $2; exit }')
        esp=$(printf '%b' "$esp")  # lsblk writes spaces as \x20
    fi
    if [ -z "$esp" ]; then
        dev=$(lsblk -rno PATH,PARTTYPE 2>/dev/null | awk -v t="$ESP_TYPE" 'tolower($2) == t { print $1; exit }')
        [ -z "$dev" ] || die "the EFI System Partition ($dev) isn't mounted. Mount it, for example: sudo mount $dev /boot/efi"
        die "couldn't find the EFI System Partition. Is it mounted (on /efi, /boot or /boot/efi)?"
    fi
    printf '%s' "$esp"
}

# Whether what's mounted on $1 is a partition of the EFI System Partition's
# type (lsblk reads it without root).
is_esp_partition() {
    local dev
    dev=$(findmnt -no SOURCE "$1" 2>/dev/null | tail -n1)
    [ -n "$dev" ] && [ "$(lsblk -no PARTTYPE "$dev" 2>/dev/null | tr A-Z a-z)" = "$ESP_TYPE" ]
}

# Prints "disk partition" for the ESP, e.g. "/dev/nvme0n1 1".
esp_disk_and_partition() {
    local dev disk part
    dev=$(findmnt -no SOURCE "$1")
    disk=$(lsblk -no PKNAME "$dev" | head -n1)
    part=$(cat "$SYS/class/block/$(basename "$dev")/partition")
    [ -n "$disk" ] && [ -n "$part" ] || die "couldn't find the disk and partition number of $dev."
    printf '/dev/%s %s' "$disk" "$part"
}

# Prints the Boot#### number of the Slingshot entry, if there is one.
# The firmware's entries, as efibootmgr lists them: what entry_number and
# boot_order read, so that a command reads the variables once.
boot_entries() { efibootmgr 2>/dev/null || true; }

# Slingshot's Boot#### number, from boot_entries on stdin.
entry_number() {
    sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\}[[:space:]]\+$LABEL\b.*/\1/p" | head -n1
}

# BootOrder, from boot_entries on stdin.
boot_order() {
    sed -n 's/^BootOrder: //p'
}

# The boot order $1 without entry $2.
boot_order_without() {
    tr ',' '\n' <<<"$1" | { grep -vix "$2" || true; } | paste -sd, -
}

secure_boot_enabled() {
    local var="$SYS/firmware/efi/efivars/SecureBoot-$GLOBAL_GUID"
    [ -r "$var" ] && [ "$(od -An -t u1 -j 4 -N 1 "$var" | tr -d ' ')" = 1 ]
}

uses_systemd_boot() {
    local esp=$1
    root_exists "$esp/EFI/systemd/systemd-boot$EFI_ARCH.efi" && root_dir "$esp/loader"
}

# The machine type in an EFI program's PE header: 8664 (x64) or aa64
# (ARM). Nothing for a file that isn't a PE program.
pe_machine() {
    local pe
    [ "$(head -c 2 "$1")" = MZ ] || return 0
    pe=$(od -An -t u4 -j 60 -N 4 "$1" | tr -d ' ')
    od -An -t x2 -j $((pe + 4)) -N 2 "$1" | tr -d ' '
}

# Finds the program to install, and checks it's for this computer (a
# release archive for PCs, unpacked on an ARM computer, has the wrong one).
find_efi_file() {
    locate_efi_file
    local machine
    machine=$(pe_machine "$EFI_FILE")
    if [ -n "$machine" ] && [ "$machine" != "$PE_MACHINE" ]; then
        die "$EFI_FILE is for another kind of processor than this computer's ($(uname -m))."
    fi
}

locate_efi_file() {
    if [ -n "$EFI_FILE" ]; then
        [ -f "$EFI_FILE" ] || die "$EFI_FILE doesn't exist."
        return
    fi
    local root built
    root=$(cd "$HERE/.." && pwd)
    # A release archive (next to this script) or a package (/usr/lib).
    if [ ! -f "$root/Cargo.toml" ]; then
        for built in "$HERE/slingshot.efi" "$root/lib/slingshot/slingshot.efi" /usr/lib/slingshot/slingshot.efi; do
            if [ -f "$built" ]; then
                EFI_FILE=$built
                return
            fi
        done
        die "slingshot.efi not found (pass --efi FILE)."
    fi
    # --sse: the x86 build with hardware floating point (the releases'),
    # its standard library built from source (.cargo/config.toml).
    local target=$UEFI_TARGET
    if [ "$SSE" = 1 ] && [ "$EFI_ARCH" != x64 ]; then
        die "--sse is for x86 PCs."
    fi
    if [ "$EFI_ARCH" != x64 ]; then
        SSE=0
    elif [ -z "$SSE" ]; then
        # It builds Rust's core library from source: rust-src, which rustup
        # can add. A Rust without rustup and without it: the slower build.
        if command -v rustup >/dev/null || [ -d "$(rustc --print sysroot 2>/dev/null)/lib/rustlib/src/rust/library" ]; then
            SSE=1
        else
            SSE=0
            warn "Building without hardware floating point (no rust-src): the screens will draw about twice as slowly."
        fi
    fi
    if [ "$SSE" = 1 ]; then
        target=x86_64-unknown-uefi-sse
    fi
    built="$root/target/$target/release/slingshot.efi"
    if [ ! -f "$built" ] || [ -n "$(find "$root/src" "$root/ui" "$root/Cargo.toml" -newer "$built" -print -quit 2>/dev/null)" ]; then
        step "Building Slingshot"
        command -v cargo >/dev/null || die "cargo is needed to build Slingshot (or pass --efi FILE)."
        if [ "$SSE" = 1 ]; then
            if command -v rustup >/dev/null && ! rustup component list --installed | grep -q '^rust-src'; then
                info "Installing the Rust component rust-src"
                rustup component add rust-src
            fi
            (cd "$root" && RUSTC_BOOTSTRAP=1 cargo build-uefi-sse)
        else
            if command -v rustup >/dev/null && ! rustup target list --installed | grep -q $UEFI_TARGET; then
                info "Installing the Rust target $UEFI_TARGET"
                rustup target add $UEFI_TARGET
            fi
            (cd "$root" && cargo build --release --target $UEFI_TARGET)
        fi
    fi
    EFI_FILE=$built
}

# Copies the wallpapers next to slingshot.toml, where Settings offers them
# (not over a file of the same name), and makes one of them, at random, the
# wallpaper unless slingshot.toml has one: it looks better than none.
add_wallpapers() { # dir
    local dir src f n=0 all=()
    # The release archive, the package, the source tree.
    for dir in "$HERE/wallpapers" "$HERE/../share/slingshot/wallpapers" "$HERE/../assets/wallpapers"; do
        [ -d "$dir" ] && break
    done
    [ -d "$dir" ] || return 0
    for src in "$dir"/*.jpg; do
        [ -f "$src" ] || continue
        all+=("$(basename "$src")")
        f="$1/${all[-1]}"
        root_exists "$f" && continue
        as_root cp "$src" "$f"
        n=$((n + 1))
    done
    if [ "$n" -gt 0 ]; then ok "Wallpapers: $n, to choose in Settings"; fi
    [ "${#all[@]}" -gt 0 ] || return 0
    f=${all[RANDOM % ${#all[@]}]}
    if toml_prepend "$1" wallpaper "$f"; then ok "Wallpaper: $f"; fi
}

# The console's keyboard layout, as slingshot.toml names it ("" for US or
# unknown): the firmware types as on a US keyboard, and a LUKS passphrase
# must be typed with the layout the initrd uses.
keyboard_layout() {
    local map
    map=$(conf_value KEYMAP "$ETC/vconsole.conf")
    if [ -z "$map" ] && [ -f "$ETC/default/keyboard" ]; then
        map=$(sed -n 's/^XKBLAYOUT="\{0,1\}\([^",]*\).*/\1/p' "$ETC/default/keyboard" | tail -1)
    fi
    if [ -z "$map" ]; then
        map=$(desktop_layout)
        map=${map%% *}
    fi
    case "$map" in
        fr*|azerty*) echo fr ;;
        de*) echo de ;;
        uk*|gb*) echo uk ;;
        es*) echo es ;;
        it*) echo it ;;
        *) echo "" ;;
    esac
}

# Adds `language = "…"` to slingshot.toml from the system's locale, when
# Slingshot is translated into it and the file doesn't say already: the
# firmware's own language setting is usually English.
write_language() { # dir
    local locale lang
    locale=$(conf_value LANG "$ETC/locale.conf" "$ETC/default/locale")
    [ -n "$locale" ] || locale=${LANG:-}
    lang=${locale%%[_.@-]*}
    case "$lang" in
        fr|de) ;;
        *) return 0 ;;
    esac
    if toml_prepend "$1" language "$lang"; then ok "Language: $lang (from the system's)"; fi
}

# Writes this system's keyboard layout as keymap.txt (`slingshot keymap`,
# which knows every XKB layout and its dead keys). Fails without the
# slingshot program, or when the layout isn't known.
write_keymap() { # dir
    local program="${SLINGSHOT_PROGRAM:-}" tmp name error
    if [ -z "$program" ]; then
        # Next to this script (release archive), in the source tree once
        # built (cargo build --release), else installed.
        for program in "$HERE/slingshot" "$HERE/../target/release/slingshot" "$(command -v slingshot 2>/dev/null)"; do
            [ ! -x "$program" ] || break
        done
    fi
    if [ ! -x "$program" ]; then
        return 1
    fi
    # Run as root: only a program that only root can change.
    if [ "$EUID" = 0 ] && ! owned_by_root "$program"; then
        warn "$program can be changed by other users than root: not running it as root."
        return 1
    fi
    tmp=$(mktemp) || return 1
    if ! error=$("$program" keymap -o "$tmp" 2>&1 >/dev/null); then
        rm -f "$tmp"
        case $error in
            *"unknown option keymap"*) info "$program is an older version, without 'keymap'." ;;
            *) warn "slingshot keymap: $(head -1 <<<"${error:-failed}")" ;;
        esac
        return 1
    fi
    name=$(sed -n 's/^name //p' "$tmp")
    as_root cp "$tmp" "$1/keymap.txt"
    rm -f "$tmp"
    ok "Keyboard layout: $name (keymap.txt)"
}

# The desktop's keyboard layout, as XKB names it ("layout variant"): the
# system's (localectl set-x11-keymap), else the user's KDE or GNOME
# settings (the user who ran sudo, pkexec or su). Desktops often have no
# console keymap: the layout is only set there.
desktop_layout() {
    local f layout="" variant="" user home sources
    f="$ETC/X11/xorg.conf.d/00-keyboard.conf"
    if [ -f "$f" ]; then
        layout=$(sed -n 's/.*Option[[:space:]]*"XkbLayout"[[:space:]]*"\([^",]*\).*/\1/p' "$f" | head -1)
        variant=$(sed -n 's/.*Option[[:space:]]*"XkbVariant"[[:space:]]*"\([^",]*\).*/\1/p' "$f" | head -1)
    fi
    if [ -z "$layout" ]; then
        user=${SUDO_USER:-}
        [ -n "$user" ] || [ -z "${PKEXEC_UID:-}" ] || user=$(id -nu "$PKEXEC_UID" 2>/dev/null || true)
        # After su: who logged in on this terminal.
        [ -n "$user" ] || [ "$EUID" != 0 ] || user=$(logname 2>/dev/null || true)
        [ -n "$user" ] || user=$(id -un)
        home=${SLINGSHOT_HOME:-$(getent passwd "$user" | cut -d: -f6)}
        f="$home/.config/kxkbrc"
        if [ -f "$f" ]; then
            layout=$(sed -n 's/^LayoutList=\([^,]*\).*/\1/p' "$f" | head -1)
            variant=$(sed -n 's/^VariantList=\([^,]*\).*/\1/p' "$f" | head -1)
        fi
        if [ -z "$layout" ] && command -v gsettings >/dev/null; then
            # [('xkb', 'fr+oss'), ('xkb', 'us')]: the first one.
            if [ "$(id -un)" = "$user" ]; then
                sources=$(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null || true)
            elif [ "$EUID" = 0 ]; then
                sources=$(runuser -u "$user" -- env HOME="$home" gsettings get org.gnome.desktop.input-sources sources 2>/dev/null || true)
            fi
            sources=$(sed -n "s/^[^(]*('xkb', '\([^']*\)').*/\1/p" <<<"${sources:-}")
            layout=${sources%%+*}
            [ "$sources" = "${sources#*+}" ] || variant=${sources#*+}
        fi
    fi
    [ -n "$layout" ] && printf '%s %s' "$layout" "$variant"
}

# The console keymaps (kbd's names) for an XKB layout, the best first.
console_maps_for() { # layout [variant]
    local variant=${2:-}
    case "$1:$variant" in
        us:dvorak*) echo dvorak ;;
        us:*) ;;
        fr:bepo*) echo fr-bepo ;;
        fr:*) echo fr-latin9 fr ;;
        gb:*) echo uk ;;
        ch:fr*) echo fr_CH-latin1 fr_CH ;;
        ch:*) echo de_CH-latin1 de_CH ;;
        de:*) echo de-latin1 de ;;
        se:*) echo sv-latin1 ;;
        br:*) echo br-abnt2 ;;
        *) echo ${variant:+$1-$variant} "$1-latin1" "$1" ;;
    esac
}

# The console's keyboard layout as keymap.txt, for when there's no slingshot
# program: the console keymap (vconsole.conf's KEYMAP, or the one Debian's
# console-setup made from the desktop's layout, else the one for the
# desktop's layout), compiled by loadkeys (without loading it) to tables of
# characters, dead keys included. The candidates, one per line.
console_keymap_source() {
    local cached map
    for cached in "$ETC"/console-setup/cached_UTF-8_*.kmap.gz "$ETC"/console-setup/cached_*.kmap.gz; do
        [ ! -f "$cached" ] || { echo "$cached"; return; }
    done
    map=$(conf_value KEYMAP "$ETC/vconsole.conf")
    if [ -n "$map" ]; then
        echo "$map"
        return
    fi
    map=$(desktop_layout)
    [ -z "$map" ] || console_maps_for ${map} | tr ' ' '\n'
}

console_keymap() { # source name
    loadkeys -q -u --mktable "$1" 2>/dev/null | awk -v name="$2" '
    function hex(s,   i, c, n) {
        n = 0; s = tolower(s); sub(/^0x/, "", s)
        for (i = 1; i <= length(s); i++) { c = index("0123456789abcdef", substr(s, i, 1)); if (!c) return -1; n = n * 16 + c - 1 }
        return n
    }
    function u(n) { return sprintf("U+%04X", n) }
    # A map entry: a character, a dead key, or "-".
    function out(v,   t, x) {
        if (v == "") return "-"
        if (v < 61440) return v ? u(v) : "-"   # Unicode (below 0xf000)
        t = int(v / 256) - 240; x = v % 256
        if ((t == 0 || t == 11) && x >= 32 && x != 127) return u(x)   # KT_LATIN, KT_LETTER
        if (t == 4 && x < 6) return "dead:" u(dead[x])                  # KT_DEAD
        return "-"
    }
    BEGIN {
        split("96 180 94 126 168 184", d, " "); for (i = 1; i <= 6; i++) dead[i - 1] = d[i]
        # The keys, by Linux keycode: their US characters.
        us = "1234567890-="; for (i = 1; i <= 12; i++) key[i + 1] = substr(us, i, 1)
        us = "qwertyuiop[]"; for (i = 1; i <= 12; i++) key[i + 15] = substr(us, i, 1)
        us = "asdfghjkl;\047"; for (i = 1; i <= 11; i++) key[i + 29] = substr(us, i, 1)
        key[41] = "`"; key[43] = "\\"
        us = "zxcvbnm,./"; for (i = 1; i <= 10; i++) key[i + 43] = substr(us, i, 1)
        # Accent characters in the accent table, and the dead keys they are.
        acc["`"] = 96; acc["\047"] = 180; acc["^"] = 94; acc["~"] = 126; acc["\""] = 168; acc[","] = 184
        ascii = ""; for (i = 32; i < 127; i++) ascii = ascii sprintf("%c", i)
    }
    /unsigned short (plain|shift|altgr|shift_altgr)_map\[/ {
        m = $0; sub(/.*unsigned short /, "", m); sub(/_map.*/, "", m); n = 0; inmap = 1; next
    }
    inmap && /^};/ { inmap = 0; next }
    inmap { gsub(/,/, " "); for (i = 1; i <= NF; i++) val[m, n++] = hex($i); next }
    /accent_table\[/ { inacc = 1; next }
    inacc && /^};/ { inacc = 0; next }
    inacc {
        line = $0
        while (match(line, /\{\047(\\.|[^\\])\047, \047(\\.|[^\\])\047, 0x[0-9a-fA-F]+\}/)) {
            e = substr(line, RSTART + 1, RLENGTH - 2); line = substr(line, RSTART + RLENGTH)
            a = substr(e, 2, 1); if (a == "\\") a = substr(e, 3, 1)
            sub(/^\047(\\.|[^\\])\047, \047/, "", e)
            b = substr(e, 1, 1); if (b == "\\") b = substr(e, 2, 1)
            sub(/^.*0x/, "0x", e)
            if ((a in acc) && index(ascii, b)) compose[++nc] = u(acc[a]) " " u(index(ascii, b) + 31) " " u(hex(e))
        }
    }
    END {
        if (!(("plain", 16) in val)) exit 1
        print "name " name
        for (k = 2; k <= 53; k++) {
            if (!(k in key)) continue
            c = key[k]
            printf "key %s %s %s %s %s\n", u(index(ascii, c) + 31), out(val["plain", k]), out(val["shift", k]), out(val["altgr", k]), out(val["shift_altgr", k])
        }
        for (i = 1; i <= nc; i++) print "compose " compose[i]
    }'
}

write_console_keymap() { # dir
    local source name tmp
    command -v loadkeys >/dev/null || return 1
    tmp=$(mktemp) || return 1
    while read -r source; do
        [ -n "$source" ] || continue
        name=$(sed -n 's/^XKBLAYOUT="\{0,1\}\([^",]*\).*/\1/p' "$ETC/default/keyboard" 2>/dev/null | tail -1)
        [ -n "$name" ] || name=$(basename "$source" .map.gz)
        # US: as the firmware types already.
        case $name in us | us.* | defkeymap) break ;; esac
        if console_keymap "$source" "$name" >"$tmp" && grep -q '^key ' "$tmp"; then
            as_root cp "$tmp" "$1/keymap.txt"
            rm -f "$tmp"
            ok "Keyboard layout: $name (keymap.txt)"
            return 0
        fi
    done <<<"$(console_keymap_source)"
    rm -f "$tmp"
    return 1
}

# The last fallback: adds `keyboard = "…"` to slingshot.toml unless it says one
# already (Slingshot's built-in layouts).
write_keyboard_layout() { # dir
    local layout
    layout=$(keyboard_layout)
    [ -n "$layout" ] || return 0
    if toml_prepend "$1" keyboard "$layout"; then ok "Keyboard layout: $layout (Slingshot's built-in one)"; fi
}

# Adds `key = "value"` at the top of slingshot.toml in dir; fails when the
# file has the key already.
toml_prepend() { # dir key value
    local file="$1/slingshot.toml" text
    # A value made of file names: nothing that would end the string.
    case $3 in *[\"\\$'\n\r']*) warn "Not writing $2 = $3 to slingshot.toml"; return 1 ;; esac
    text=$(root_cat "$file")
    ! grep -q "^[[:space:]]*$2[[:space:]]*=" <<<"$text" || return 1
    printf '%s = "%s"\n%s' "$2" "$3" "${text:+$text$'\n'}" | root_write "$file"
}

# --- encrypted disks and unified kernel images -----------------------------
# Slingshot can't unlock the disk for a unified kernel image (its initrd is
# signed with it): it needs an entry with the kernel and the initramfs as
# separate files, which mkinitcpio can build too (docs/encrypted-disks.md).

# The kernel command line mkinitcpio builds unified images with.
uki_cmdline() {
    { cat "$ETC/kernel/cmdline" 2>/dev/null || cat "$ETC"/cmdline.d/*.conf 2>/dev/null || true; } \
        | { grep -v '^[[:space:]]*#' || true; } | tr -s ' \n' '  ' | sed 's/^ //; s/ $//'
}

# Whether the command line opens an encrypted disk.
opens_luks() {
    [[ " $1 " =~ [[:space:]](cryptdevice|rd\.luks\.uuid|rd\.luks\.name)= ]]
}

# The mkinitcpio presets that build a unified image on the ESP $1 and have
# no entry yet, as "pkgbase kernel image has_image entry" lines: the kernel
# and the initramfs the entry needs (where mkinitcpio puts them, or would),
# whether the preset builds that initramfs already, and the entry to write
# (arch-linux.efi → arch-linux.conf). Skips (with a warning) a kernel copied
# outside the ESP, which the firmware can't read.
pending_entries() {
    local esp=$1 preset pkgbase kernel image uki
    command -v mkinitcpio >/dev/null || return 0
    for preset in "$ETC"/mkinitcpio.d/*.preset; do
        [ -f "$preset" ] || continue
        pkgbase=$(basename "$preset" .preset)
        read -r kernel image uki < <(
            # shellcheck disable=SC1090
            . "$preset" >/dev/null 2>&1
            printf '%s %s %s\n' "${ALL_kver:-/boot/vmlinuz-$pkgbase}" "${default_image:--}" "${default_uki:--}"
        )
        [ "$uki" != - ] || continue
        local entry="$esp/loader/entries/$(basename "$uki" .efi).conf" has_image=1
        ! root_exists "$entry" || continue
        if [ "$image" = - ]; then
            image="$(dirname "$kernel")/initramfs-$pkgbase.img"
            has_image=0
        fi
        if [[ "$kernel" != "$esp"/* || "$image" != "$esp"/* ]]; then
            warn "$pkgbase: its kernel or initramfs isn't on the EFI System Partition ($kernel): see $DOCS/encrypted-disks.md" >&2
            continue
        fi
        printf '%s %s %s %s %s\n' "$pkgbase" "$kernel" "$image" "$has_image" "$entry"
    done
}

# The entry's initrd lines for the microcode, unless mkinitcpio puts it into
# the initramfs (the `microcode` hook).
microcode_initrds() { # esp
    grep -qs '^[[:space:]]*HOOKS=.*\bmicrocode\b' "$ETC/mkinitcpio.conf" "$ETC"/mkinitcpio.conf.d/*.conf && return 0
    for ucode in "$1"/amd-ucode.img "$1"/intel-ucode.img; do
        if root_exists "$ucode"; then printf 'initrd  /%s\n' "${ucode##*/}"; fi
    done
}

# Makes `match` Slingshot's default entry, unless slingshot.toml has one:
# as the first rule, since the first that matches an entry is the one used.
make_slingshot_default() { # esp match
    local toml="$1/$ESP_DIR/slingshot.toml" text
    root_dir "$1/$ESP_DIR" || return 0
    text=$(root_cat "$toml")
    ! grep -q '^[[:space:]]*default[[:space:]]*=[[:space:]]*true' <<<"$text" || return 0
    ask "Make it Slingshot's default entry?" || return 0
    printf '%s' "${text:+$text$'\n'}" | awk -v m="$2" '
        function rule() { printf "[[entry]]\nmatch = \"%s\"\ndefault = true\n", m }
        !done && /^[[:space:]]*\[\[entry\]\]/ { rule(); print ""; done = 1 }
        { print }
        END { if (!done) { print ""; rule() } }' | root_write "$toml"
    ok "Slingshot's default: $2"
}

# `pending`: what pending_entries says, when the caller has it already.
add_unlock_entries() { # esp [pending]
    local esp=$1 cmdline title ucode pkgbase kernel image has_image entry name first="" pending=0
    cmdline=$(uki_cmdline)
    [ -n "$cmdline" ] || die "no kernel command line in $ETC/kernel/cmdline or $ETC/cmdline.d/: the entry needs one."
    opens_luks "$cmdline" || die "the kernel command line doesn't open an encrypted disk (cryptdevice=, rd.luks.uuid=, rd.luks.name=)."
    title=$(conf_value PRETTY_NAME "$ETC/os-release" /usr/lib/os-release)
    ucode=$(microcode_initrds "$esp")
    as_root mkdir -p "$esp/loader/entries"
    while read -r pkgbase kernel image has_image entry; do
        pending=1
        # The initramfs as well as the unified image, now and on updates. A
        # full build (the unified image too) only when it's missing.
        if [ "$has_image" = 0 ]; then
            printf '\n%s, for Slingshot to ask for the passphrase of\n# the encrypted disk: %s/encrypted-disks.md\n# (`slingshot-setup uninstall` removes these lines).\ndefault_image="%s"\n' "$PRESET_MARK" "$DOCS" "$image" \
                | root_write "$ETC/mkinitcpio.d/$pkgbase.preset" -a
            ok "$pkgbase.preset: builds $image too"
        fi
        if [ "$has_image" = 0 ] || ! root_exists "$image" || [ "$REBUILD" = 1 ]; then
            as_root mkinitcpio -p "$pkgbase"
            BUILT="$BUILT$pkgbase "
        fi
        if [ "$DRY_RUN" = 0 ] && ! { root_exists "$kernel" && root_exists "$image"; }; then
            warn "$pkgbase: mkinitcpio didn't make $kernel and $image: no entry written."
            continue
        fi
        name=${title:-Linux}
        [ "$pkgbase" = linux ] || name="$name ($pkgbase)"
        {
            printf '%s: the kernel and initramfs as separate files, for\n' "$LUKS_ENTRY_MARK"
            printf '# Slingshot to ask for the passphrase of the encrypted disk:\n# %s/encrypted-disks.md\n' "$DOCS"
            printf '# Keep the options as in %s/kernel/cmdline. `slingshot-setup uninstall`\n# removes this entry.\n' "$ETC"
            printf 'title   %s\nlinux   %s\n' "$name" "${kernel#"$esp"}"
            printf '%s' "${ucode:+$ucode$'\n'}"
            printf 'initrd  %s\noptions %s\n' "${image#"$esp"}" "$cmdline"
        } | root_write "$entry"
        ok "Added $entry (\"$name\")"
        first=${first:-$(basename "$entry")}
    done < <(if [ $# -ge 2 ]; then printf '%s\n' "$2"; else pending_entries "$esp"; fi)
    if [ "$pending" = 0 ]; then
        ok "Nothing to add: each unified kernel image has its entry."
    fi
    [ -n "$first" ] || return 0
    make_slingshot_default "$esp" "$first"
    info "If you change the kernel command line, change the entry's options line too."
}

# Undoes luks-entry: its entries, and in the presets, the initramfs it
# turned on (and that initramfs, which nothing would update any more).
remove_luks_entries() { # esp
    local esp=$1 entry preset image text
    # One file per line, whatever its name has (spaces, *).
    while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        as_root rm -f -- "$entry"
        ok "Removed $entry"
    done < <(luks_entry_files "$esp")
    for preset in "$ETC"/mkinitcpio.d/*.preset; do
        grep -qs "^$PRESET_MARK" "$preset" || continue
        image=$(sed -n "/^$PRESET_MARK/,/^default_image=/s/^default_image=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$preset")
        # The marked lines, and the empty line before them. Read whole
        # first: tee empties the file as it starts.
        text=$(cat "$preset")
        awk -v mark="$PRESET_MARK" '
            index($0, mark) == 1 { skip = 1; blank = 0 }
            skip { if ($0 ~ /^default_image=/) skip = 0; next }
            blank { print ""; blank = 0 }
            /^$/ { blank = 1; next }
            { print }
            END { if (blank) print "" }' <<<"$text" | root_write "$preset"
        ok "$(basename "$preset"): the initramfs is no longer built"
        if [ -n "$image" ] && root_exists "$image"; then
            as_root rm -f "$image"
            ok "Removed $image"
        fi
    done
}

# --- encrypt → sd-encrypt ---------------------------------------------------
# mkinitcpio's busybox `encrypt` hook can only open the disk with the
# passphrase: it derives the key again, a pause as long as Slingshot's own
# check. `sd-encrypt` (systemd) takes the volume key Slingshot found.

# The hooks known to work in a systemd-based initramfs. Others (netconf,
# dropbear…) are busybox ones: then the switch is left to the user.
SYSTEMD_HOOKS=" base systemd autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt lvm2 mdadm_udev filesystems fsck btrfs plymouth "

# The HOOKS of mkinitcpio.conf, when they have `encrypt` and are on one line
# of that file (not in a drop-in, which would need its own edit).
encrypt_hooks() {
    local conf="$ETC/mkinitcpio.conf" hooks
    [ "$(grep -c '^[[:space:]]*HOOKS=' "$conf" 2>/dev/null)" = 1 ] || return 1
    grep -q '^[[:space:]]*HOOKS=(.*)[[:space:]]*$' "$conf" || return 1
    ! grep -qs '^[[:space:]]*HOOKS=' "$ETC"/mkinitcpio.conf.d/*.conf || return 1
    # shellcheck disable=SC1090
    hooks=$(. "$conf" >/dev/null 2>&1; echo "${HOOKS[*]}")
    [[ " $hooks " == *" encrypt "* ]] || return 1
    printf '%s' "$hooks"
}

# The same hooks for systemd, or fails when one has no known equivalent.
systemd_hooks() { # hooks
    local h out=() vconsole=0
    for h in $1; do
        case $h in
            udev) out+=(systemd) ;;
            keymap | consolefont)
                [ "$vconsole" = 1 ] || out+=(sd-vconsole)
                vconsole=1
                ;;
            encrypt) out+=(sd-encrypt) ;;
            resume) ;; # systemd resumes by itself
            *) out+=("$h") ;;
        esac
    done
    for h in "${out[@]}"; do
        [[ "$SYSTEMD_HOOKS" == *" $h "* ]] || return 1
    done
    printf '%s' "${out[*]}"
}

# The UUID of the LUKS volume on the device $1: from udev (lsblk), else
# from its header (which needs root).
luks_uuid() {
    local uuid
    uuid=$(lsblk -dno UUID "$1" 2>/dev/null || true)
    [ ${#uuid} = 36 ] || uuid=$(as_user_or_root cryptsetup luksUUID "$1" || true)
    [ ${#uuid} = 36 ] && printf '%s' "$uuid"
}

# rd.luks.name= (and rd.luks.options=) for the cryptdevice= option $1, or
# fails for what it can't say the same way.
systemd_luks_options() { # cryptdevice=device:name[:options]
    local device name options uuid
    IFS=: read -r device name options <<<"${1#cryptdevice=}"
    case $options in "" | allow-discards | discard) ;; *) return 1 ;; esac
    case $device in
        UUID=*) uuid=${device#UUID=} ;;
        PARTUUID=*) uuid=$(luks_uuid "/dev/disk/by-partuuid/${device#PARTUUID=}") ;;
        /dev/*) uuid=$(luks_uuid "$device") ;;
        *) return 1 ;;
    esac
    [ -n "$uuid" ] || return 1
    printf 'rd.luks.name=%s=%s' "$uuid" "${name:-cryptroot}"
    if [ -n "$options" ]; then printf ' rd.luks.options=%s=discard' "$uuid"; fi
}

# The files the kernel command line comes from (see uki_cmdline).
cmdline_files() {
    if [ -f "$ETC/kernel/cmdline" ]; then
        printf '%s\n' "$ETC/kernel/cmdline"
    else
        for f in "$ETC"/cmdline.d/*.conf; do
            if [ -f "$f" ]; then printf '%s\n' "$f"; fi
        done
    fi
}

# Replaces $2 by $3 in the file $1 (as root), keeping a copy of the file
# as it was the first time.
replace_in() { # file old new
    local text
    text=$(root_cat "$1")
    [[ "$text" == *"$2"* ]] || return 0
    root_exists "$1.slingshot-setup.bak" || as_root cp -p "$1" "$1.slingshot-setup.bak"
    printf '%s\n' "${text//"$2"/"$3"}" | root_write "$1"
}

# The loader entries grep matches (as root when only root can read them:
# the folder's glob too).
grep_entries() { # esp grep-args…
    local esp=$1
    shift
    { grep -l "$@" "$esp"/loader/entries/*.conf 2>/dev/null \
        || as_root_quietly sh -c 'd=$1; shift; grep -l "$@" "$d"/loader/entries/*.conf' sh "$esp" "$@"; } || true
}

# The entries luks-entry wrote.
luks_entry_files() { grep_entries "$1" -e "^$LUKS_ENTRY_MARK"; } # esp

# The loader entries that have $2.
loader_entries_with() { grep_entries "$1" -F -e "$2"; } # esp text

# Whether mkinitcpio puts the cryptsetup program in the initramfs: the
# sd-encrypt hook has systemd-cryptsetup, not it, and Slingshot's unit needs
# it to open the disk with the volume key.
initramfs_has_cryptsetup() {
    # shellcheck disable=SC1090
    (
        . "$ETC/mkinitcpio.conf"
        for f in "$ETC"/mkinitcpio.conf.d/*.conf; do
            if [ -f "$f" ]; then . "$f"; fi
        done
        [[ " ${BINARIES[*]} " =~ [/[:space:]]cryptsetup[[:space:]] ]]
    ) >/dev/null 2>&1
}

add_cryptsetup() {
    printf '\n# slingshot-setup: the cryptsetup program, for Slingshot to hand the\n# unlocked disk over: %s/encrypted-disks.md\nBINARIES+=(cryptsetup)\n' "$DOCS" \
        | root_write "$ETC/mkinitcpio.conf" -a
    ok "The initramfs gets the cryptsetup program"
    REBUILD=1
}

# Already sd-encrypt, without cryptsetup: offers it.
offer_cryptsetup() {
    # shellcheck disable=SC1090
    (. "$ETC/mkinitcpio.conf" >/dev/null 2>&1; [[ " ${HOOKS[*]} " == *" sd-encrypt "* ]]) || return 0
    ! initramfs_has_cryptsetup || return 0
    step "The initramfs has no cryptsetup program"
    info "Slingshot's unit needs it to open the disk with the key Slingshot found: without"
    info "it, the initramfs derives the key from the passphrase again."
    if ask "Add it to $ETC/mkinitcpio.conf?"; then add_cryptsetup; fi
}

# Offers the switch; REBUILD=1 once done (the initramfs then needs
# building again).
REBUILD=0
switch_to_sd_encrypt() { # esp
    local esp=$1 hooks new_hooks option="" new f files
    hooks=$(encrypt_hooks) || return 0
    files=$(cmdline_files)
    step "The initramfs opens the disk with mkinitcpio's encrypt hook"
    info "It derives the key from the passphrase again, which pauses the boot: sd-encrypt"
    info "takes the key Slingshot found. $DOCS/encrypted-disks.md#faster-with-sd-encrypt-than-with-encrypt"
    if [ -n "$files" ]; then
        option=$({ grep -hv '^[[:space:]]*#' $files 2>/dev/null || true; } | grep -o 'cryptdevice=[^[:space:]]*' | head -n1 || true)
    fi
    if ! new_hooks=$(systemd_hooks "$hooks"); then
        warn "Some of the hooks have no systemd version that this script knows: see the link to switch."
        return 0
    fi
    if [ -z "$option" ]; then
        warn "No cryptdevice= in the kernel options ($ETC/kernel/cmdline): see the link to switch."
        return 0
    fi
    if ! new=$(systemd_luks_options "$option"); then
        warn "This script can't switch $option (its device's LUKS UUID wasn't found, or"
        warn "its options aren't only allow-discards): see the link to switch."
        return 0
    fi
    info "HOOKS: $new_hooks, and the cryptsetup program"
    info "Kernel options: $option → $new"
    ask "Switch to sd-encrypt?" || return 0
    replace_in "$ETC/mkinitcpio.conf" "$(grep '^[[:space:]]*HOOKS=' "$ETC/mkinitcpio.conf")" "HOOKS=($new_hooks)"
    # Every entry that opens the disk this way: sd-encrypt ignores cryptdevice=.
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        replace_in "$f" "$option" "$new"
    done < <(printf '%s\n' $files; loader_entries_with "$esp" "$option")
    if grep -qsF "$option" "$ETC/default/grub"; then
        warn "GRUB has $option too: change it to $new in $ETC/default/grub, then"
        warn "run grub-mkconfig -o /boot/grub/grub.cfg."
    fi
    ok "Switched (the files as they were: *.slingshot-setup.bak)"
    initramfs_has_cryptsetup || add_cryptsetup
    REBUILD=1
}

# After the switch: builds the initramfs of the presets add_unlock_entries
# didn't build, and checks that they have the cryptsetup program, which the
# volume key needs.
finish_sd_encrypt() { # esp
    local preset pkgbase entry image
    [ "$REBUILD" = 1 ] || return 0
    for preset in "$ETC"/mkinitcpio.d/*.preset; do
        [ -f "$preset" ] || continue
        pkgbase=$(basename "$preset" .preset)
        [[ "$BUILT" == *" $pkgbase "* ]] || as_root mkinitcpio -p "$pkgbase"
    done
    [ "$DRY_RUN" = 0 ] || return 0
    while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        image=$1$(root_cat "$entry" | sed -n 's/^initrd[[:space:]]\{1,\}\(.*initramfs.*\)$/\1/p' | tail -1)
        if ! as_user_or_root lsinitcpio "$image" | grep -q 'bin/cryptsetup$'; then
            warn "$image has no cryptsetup program: the initramfs derives the key again. See $DOCS/encrypted-disks.md"
        fi
    done < <(luks_entry_files "$1")
}

# --- file system drivers ------------------------------------------------------

# The file system /boot is on: where the kernels are (/boot itself when it's
# a mount point, often the EFI System Partition, else /). The firmware only
# reads FAT; for the others, Slingshot needs a driver.
kernel_filesystems() {
    findmnt -no FSTYPE /boot 2>/dev/null || findmnt -no FSTYPE / 2>/dev/null || true
}

# rEFInd's driver for a file system type ("" if it has none).
driver_name() { # fstype
    case $1 in
        ext2 | ext3 | ext4) echo "ext4_$EFI_ARCH.efi" ;;
        btrfs) echo "btrfs_$EFI_ARCH.efi" ;;
        reiserfs) echo "reiserfs_$EFI_ARCH.efi" ;;
        hfsplus) echo "hfs_$EFI_ARCH.efi" ;;
        iso9660) echo "iso9660_$EFI_ARCH.efi" ;;
    esac
}

# EfiFs (https://github.com/pbatard/efifs, GRUB's file system code as EFI
# drivers): downloaded when rEFInd's package has no driver for the file
# system (XFS, F2FS, ZFS…), or isn't installed. Checked against these
# sums before being copied, or signed.
EFIFS_VERSION=1.13
EFIFS_URL=${SLINGSHOT_EFIFS_URL:-https://github.com/pbatard/efifs/releases/download/v$EFIFS_VERSION}
